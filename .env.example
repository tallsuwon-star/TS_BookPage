# ---------------------------------------------------------------------------
# 이 파일을 복사해 .env 로 만든 뒤 실제 값을 채워 넣으세요. (.env는 절대 커밋 금지)
#
# ⚠️ 보안 경고
# - VITE_GITHUB_TOKEN은 빌드 결과물(JS 번들)에 그대로 포함되어 누구나 볼 수 있습니다.
# - 반드시 "이 저장소 하나에만" 접근 가능한 Fine-grained Personal Access Token을
#   발급받아 사용하세요. (Repository access: Only select repositories → 이 저장소만 선택)
#   필요한 권한: Contents (Read and write)
# - 절대 Classic Token이나 여러 저장소/조직 권한이 포함된 토큰을 사용하지 마세요.
# - 이 저장소는 반드시 Private으로 유지하고, 팀 내부 테스트 용도로만 사용하세요.
# - 실제 회원 개인정보(이름, 연락처, 이메일 등)는 이 저장소(data.json)에 절대
#   올리지 마세요. 회원 데이터가 필요해지는 시점부터는 Supabase/Firebase 등
#   별도 백엔드로 전환해야 합니다.
# ---------------------------------------------------------------------------

# GitHub Fine-grained Personal Access Token (이 저장소 전용, Contents R/W 권한만)
VITE_GITHUB_TOKEN=

# 데이터를 저장할 저장소 정보
VITE_GITHUB_OWNER=tallsuwon-star
VITE_GITHUB_REPO=TsBookPage
VITE_GITHUB_BRANCH=main

# data.json 파일 경로 (저장소 루트 기준)
VITE_DATA_FILE_PATH=data.json
